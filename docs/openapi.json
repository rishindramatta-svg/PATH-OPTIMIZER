  "components": {
    "schemas": {
      "AnswerIn": {
        "properties": {
          "questionId": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Questionid"
          },
          "answer": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^[0-9]{1,2}$",
            "title": "Answer"
          },
          "confidence": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Confidence"
          },
          "timeTakenMs": {
            "type": "integer",
            "maximum": 3600000.0,
            "minimum": 0.0,
            "title": "Timetakenms"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid",
